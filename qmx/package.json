{
  "name": "qmx",
  "version": "1.0.0",
  "description": "QMX - Qwen Multi-agent eXtension: Power tools for Qwen Code CLI",
  "main": "dist/index.js",
  "bin": {
    "qmx": "./bin/qmx.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
